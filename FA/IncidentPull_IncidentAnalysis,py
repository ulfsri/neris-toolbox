def calculate_date_range(range_type, start_date=None, end_date=None):
    now   = datetime.now(tz=timezone.utc)
    today = now.replace(hour=0, minute=0, second=0, microsecond=0)

    if range_type == "All Records":
        return None, None
    elif range_type == "Occurred Today":
        return today, None
    elif range_type == "Occurred Yesterday":
        yesterday = today - timedelta(days=1)
        return yesterday, yesterday.replace(hour=23, minute=59, second=59)
    elif range_type == "Occurred Last 7 Days":
        return today - timedelta(days=7), None
    elif range_type == "Occurred Last 30 Days":
        return today - timedelta(days=30), None
    elif range_type == "Occurred Last 90 Days":
        return today - timedelta(days=90), None
    elif range_type.startswith("Occurred in "):
        year = int(range_type.split()[-1])
        return (
            datetime(year, 1,  1,  0,  0,  0, tzinfo=timezone.utc),
            datetime(year, 12, 31, 23, 59, 59, tzinfo=timezone.utc),
        )
    elif range_type == "Custom Date Range" and start_date and end_date:
        start_dt = datetime.combine(start_date, datetime.min.time(), tzinfo=timezone.utc)
        end_dt   = datetime.combine(
            end_date, datetime.max.time().replace(microsecond=0), tzinfo=timezone.utc
        )
        return start_dt, end_dt
    return None, None


BASE_URL = "https://api.neris.fsri.org/v1"

_auth_lock = threading.Lock()
_patched = {"done": False}
_last_reauth_at = {"t": 0.0}
_MFA_INPUT_TIMEOUT_SECONDS = 600
_RATE_LIMITS = [(20, 5.0)]          # no more than 20 requests in any 5 seconds
_rate_lock = threading.Lock()
_request_times = [deque() for _ in _RATE_LIMITS]


class NerisPermissionDenied(RuntimeError):
    """NERIS accepted the login but this account can't see the requested data."""


def _is_permission_denied(res):
    import requests
    if not isinstance(res, requests.Response) or res.status_code != 403:
        return False
    try:
        body = res.json()
    except ValueError:
        return False          # HTML/empty 403: the gateway rejecting the token
    return isinstance(body, dict) and "detail" in body


def _looks_like_auth_drop(res):
    import requests
    if not isinstance(res, requests.Response):
        return False
    if res.status_code == 401:
        return True
    return res.status_code == 403 and not _is_permission_denied(res)


def _input_with_timeout(prompt, timeout_seconds):
    """input() that gives up after timeout_seconds instead of waiting forever."""
    import queue
    q = queue.Queue(maxsize=1)

    def _reader():
        try:
            q.put(input(prompt))
        except Exception:
            pass

    threading.Thread(target=_reader, daemon=True).start()
    try:
        return q.get(timeout=timeout_seconds)
    except queue.Empty:
        raise TimeoutError(f"No MFA code entered within {timeout_seconds}s — "
                           f"requesting a fresh code")


def _install_auth_patch():
    if _patched["done"]:
        return
    import requests
    from neris_api_client.client import _NerisApiClient
    from neris_api_client.config import TokenSet, GrantType

    def _safe_update_auth(self):
        # Still valid for more than 2 minutes: nothing to do.
        if self.tokens.expires_at > datetime.now() + timedelta(seconds=120):
            return

        token_url = f"{self.config.base_url}/token"
        form = {"Content-Type": "application/x-www-form-urlencoded"}

        def _store(got):
            self.tokens = TokenSet(
                access_token=got["access_token"],
                refresh_token=got.get("refresh_token") or "",
                expires_at=datetime.now() + timedelta(seconds=int(got.get("expires_in") or 3600)),
            )
            _last_reauth_at["t"] = time.monotonic()

        # 1) Try the refresh token first (no MFA needed).
        if self.tokens.refresh_token:
            res = self._session.post(token_url, headers=form, timeout=30,
                                     data={"grant_type": "refresh_token",
                                           "refresh_token": self.tokens.refresh_token})
            if res.status_code == 200:
                _store(res.json())
                return
            print(f"\n  (token refresh returned HTTP {res.status_code} — logging in again)")

        # 2) Full email/password login, answering the MFA challenge if asked.
        res = self._session.post(token_url, headers=form, timeout=30,
                                 data={"grant_type": GrantType.PASSWORD,
                                       "username": self.config.username,
                                       "password": self.config.password})
        while True:
            try:
                got = res.json()
            except ValueError:
                got = {}
            if res.status_code == 200:
                _store(got)
                return
            if res.status_code == 202 and got.get("challenge_name"):
                print("\n" + "=" * 60)
                print("  CHECK YOUR EMAIL FOR THE MFA CODE")
                print(f"  (waits up to {_MFA_INPUT_TIMEOUT_SECONDS // 60} minutes, then asks for a fresh code)")
                print("=" * 60)
                code = _input_with_timeout(f"Provide MFA code for {got['challenge_name']}: ",
                                           _MFA_INPUT_TIMEOUT_SECONDS).strip()
                res = self._session.post(token_url, headers=form, timeout=30, data={
                    "grant_type": got["challenge_name"],
                    "username": self.config.username,
                    "session": got.get("session", ""),
                    got["challenge_name"]: code,
                })
                continue
            self.tokens = TokenSet(access_token="", refresh_token="", expires_at=datetime.min)
            raise RuntimeError(f"Login failed: token endpoint returned HTTP {res.status_code} - "
                               f"{res.text[:300]!r}")

    _NerisApiClient._update_auth = _safe_update_auth

    def _send(self, token, method, path, data=None, params=None, model=None):
        """The request half of the library's _call(), run without the lock,
        using exactly the token that was checked under the lock."""
        if self.config.validate and model:
            if isinstance(data, str):
                data = model.model_validate_json(data).model_dump(mode="json", by_alias=True)
            if isinstance(data, dict):
                data = model.model_validate(data).model_dump(mode="json", by_alias=True)
        headers = {"Authorization": f"Bearer {token}"}
        res = getattr(self._session, method)(
            f"{self.config.base_url}{path}", json=data, params=params, headers=headers
        )
        try:
            res.raise_for_status()
        except requests.exceptions.HTTPError:
            return res          # same as the library: raw Response on HTTP errors
        try:
            return res.json()
        except requests.exceptions.JSONDecodeError:
            return res.text

    def _locked_call(self, *args, **kwargs):
        max_attempts = 3
        res = None
        for attempt in range(1, max_attempts + 1):
            with _auth_lock:
                self._update_auth()
                token_used = self.tokens.access_token
            res = _send(self, token_used, *args, **kwargs)
            if not _looks_like_auth_drop(res) or attempt == max_attempts:
                return res
            cooldown = False
            with _auth_lock:
                if self.tokens.access_token != token_used:
                    pass                                  # another thread already renewed it
                elif time.monotonic() - _last_reauth_at["t"] < 5.0:
                    cooldown = True                       # just renewed: don't start a 2nd login
                else:
                    self.tokens.expires_at = datetime.min
                    try:
                        self._update_auth()
                    except Exception as e:
                        print(f"  ⚠ Re-authentication failed: {e}")
            if cooldown:
                time.sleep(1.5)                           # outside the lock
            print(f"  (token rejected with HTTP {res.status_code} — retrying with a fresh token)")
        return res

    _NerisApiClient._call = _locked_call

    orig_request = _NerisApiClient._session.request

    def _wait_for_rate_budget():
        while True:
            with _rate_lock:
                now = time.monotonic()
                sleep_for = 0.0
                for (max_req, window), times in zip(_RATE_LIMITS, _request_times):
                    while times and now - times[0] > window:
                        times.popleft()
                    if len(times) >= max_req:
                        sleep_for = max(sleep_for, window - (now - times[0]) + 0.05)
                if sleep_for <= 0:
                    for times in _request_times:
                        times.append(now)
                    return
            time.sleep(sleep_for)

    def _throttled_request(method, url, *args, **kwargs):
        kwargs.setdefault("timeout", 60)
        for attempt in range(1, 7):
            _wait_for_rate_budget()
            resp = orig_request(method, url, *args, **kwargs)
            if resp.status_code != 429 or attempt == 6:
                return resp
            wait = min(120, 5 * 2 ** (attempt - 1))
            print(f"  ⚠ Rate limited (HTTP 429) — waiting {wait}s (attempt {attempt}/6)")
            time.sleep(wait)
        return resp

    _NerisApiClient._session.request = _throttled_request
    _patched["done"] = True


def _unwrap(res, context):
    """The client returns the raw Response on HTTP errors instead of raising;
    turn that into a clear error so a failure never looks like "no data"."""
    import requests
    if isinstance(res, requests.Response):
        if _is_permission_denied(res):
            raise NerisPermissionDenied(f"{context}: HTTP 403 {res.text[:200]}")
        raise RuntimeError(f"{context} failed: HTTP {res.status_code} - {res.text[:300]!r}")
    return res


def authenticate(username, password):
    from neris_api_client import NerisApiClient, Config
    from neris_api_client.config import GrantType
    _install_auth_patch()
    print("\nConnecting to NERIS API...")
    client = NerisApiClient(Config(
        base_url=BASE_URL,
        grant_type=GrantType.PASSWORD,
        username=username,
        password=password,
    ))
    # health() is a trivial endpoint that still goes through the full login
    # (including MFA), without making NERIS run a big query just to log in.
    for attempt in range(1, 4):
        try:
            _unwrap(client.health(), "auth check (health)")
            print("✓ Authentication successful!")
            return client
        except TimeoutError as e:
            if attempt < 3:
                print(f"\n⚠ {e}")
                continue
            sys.exit(f"✗ Authentication failed: {e}")
        except Exception as e:
            if "HTTP 50" in str(e) and attempt < 3:
                print(f"⚠ Transient server error ({e}) — retrying in {attempt * 5}s")
                time.sleep(attempt * 5)
                continue
            sys.exit(f"✗ Authentication failed: {e}")

def _with_retries(fn, label, attempts=3):
    """Call fn(); retry transient failures. Permission denials are not retried."""
    for attempt in range(1, attempts + 1):
        try:
            return fn()
        except NerisPermissionDenied:
            raise
        except Exception as e:
            if attempt == attempts:
                raise
            print(f"  ⚠ {label} failed ({e}) — retrying in {5 * attempt}s")
            time.sleep(5 * attempt)


def get_entity_set_neris_ids(client, entity_set_nuid):
    """GET /auth/entity_set/{id}: the entity set's name, type and members.
    Routed through the client's _call() so it gets the same token handling."""
    print(f"\nFetching entity set: {entity_set_nuid}")
    try:
        data = _with_retries(
            lambda: _unwrap(client._call("get", f"/auth/entity_set/{entity_set_nuid}"),
                            "entity set lookup"),
            "entity set lookup")
    except Exception as e:
        sys.exit(f"✗ Could not fetch entity set: {e}")
    if not isinstance(data, dict):
        sys.exit("✗ Unexpected response format for entity set.")

    name    = data.get("name", "")
    es_type = data.get("type", "")
    neris_ids, seen = [], set()
    for m in data.get("members", []) or []:
        nid = (m or {}).get("neris_id", "")
        if nid and nid not in seen:
            seen.add(nid)
            neris_ids.append(nid)

    print(f"✓ Entity set: {name or entity_set_nuid} (type: {es_type or 'unknown'})")
    print(f"✓ {len(neris_ids)} member NERIS IDs found")
    return neris_ids, name or entity_set_nuid


def fetch_incidents_for_entity(client, neris_id, call_create_start=None,
                               call_create_end=None, page_size=100):
    """All incidents for one department. Raises if a page still fails after
    retries, so the department is reported as failed rather than as empty."""
    all_incidents, next_cursor, page = [], None, 0
    while True:
        page += 1
        kwargs = {"neris_id_entity": neris_id, "page_size": page_size}
        if call_create_start: kwargs["call_create_start"] = call_create_start
        if call_create_end:   kwargs["call_create_end"]   = call_create_end
        if next_cursor:       kwargs["cursor"]            = next_cursor

        res = _with_retries(
            lambda: _unwrap(client.list_incidents(**kwargs), f"incidents {neris_id} page {page}"),
            f"incidents {neris_id} page {page}")
        batch = res.get("incidents", []) or []
        if not batch:
            break
        all_incidents.extend(batch)
        next_cursor = res.get("next_cursor")
        if not next_cursor:
            break
    return all_incidents


def fetch_analyses_for_entity(client, neris_id, page_size=100):
    """All incident analyses for one department (GET /incident_analysis, same
    endpoint as the wildfire report). Asks for GeoJSON geometry; if the API
    rejects geo_format, retries without it."""
    out, next_cursor, page, use_geo = [], None, 0, True
    while True:
        page += 1
        params = {"neris_id_entity": neris_id, "page_size": page_size}
        if use_geo:
            params["geo_format"] = "geojson"
        if next_cursor:
            params["cursor"] = next_cursor

        def _get():
            res = client._call("get", "/incident_analysis", params=params)
            if not isinstance(res, dict) and use_geo and not _is_permission_denied(res) \
                    and getattr(res, "status_code", 0) in (400, 422):
                return "RETRY_WITHOUT_GEO"
            return _unwrap(res, f"incident analyses {neris_id} page {page}")

        res = _with_retries(_get, f"incident analyses {neris_id} page {page}")
        if res == "RETRY_WITHOUT_GEO":
            use_geo = False
            page -= 1
            continue
        batch = res.get("incident_analyses", []) or []
        out.extend(batch)
        next_cursor = res.get("next_cursor")
        if not batch or not next_cursor:
            break
    return out


def fetch_all(client, neris_ids, what, fetch_fn, max_workers=10, **kwargs):
    """Run fetch_fn for every department in parallel. Returns (records, errors)."""
    records, errors, completed = [], [], 0
    print(f"\nFetching {what} for {len(neris_ids)} departments in parallel...")
    with ThreadPoolExecutor(max_workers=max_workers) as executor:
        futures = {executor.submit(fetch_fn, client, nid, **kwargs): nid for nid in neris_ids}
        for future in as_completed(futures):
            nid = futures[future]
            try:
                records.extend(future.result())
            except NerisPermissionDenied as e:
                errors.append((nid, f"not permitted ({e})"))
            except Exception as e:
                errors.append((nid, str(e)))
            completed += 1
            if completed % 10 == 0 or completed == len(neris_ids):
                print(f"  {completed}/{len(neris_ids)} departments complete "
                      f"({len(records)} {what} so far)")
    if errors:
        print(f"\n⚠ {len(errors)} department(s) could not be fetched for {what}:")
        for nid, err in errors[:5]:
            print(f"    {nid}: {err}")
        if len(errors) > 5:
            print(f"    ... and {len(errors) - 5} more")
    print(f"✓ Total {what} retrieved: {len(records)}")
    return records, errors


def match_analyses(incidents, analyses):
    """incident NERIS ID -> analysis. Matches on the analysis's
    base.neris_id_incident, falling back to the incident's
    incident_analysis_neris_id. If several analyses point at one incident,
    the most recently modified wins (same rules as the wildfire report)."""
    by_incident, by_ia_id = {}, {}
    for ia in analyses:
        if not isinstance(ia, dict):
            continue
        by_ia_id[ia.get("neris_id")] = ia
        inc_id = (ia.get("base") or {}).get("neris_id_incident")
        if inc_id:
            prev = by_incident.get(inc_id)
            if not prev or str(ia.get("last_modified", "")) > str(prev.get("last_modified", "")):
                by_incident[inc_id] = ia
    matched = {}
    for inc in incidents:
        inc_id = inc.get("neris_id")
        ia = by_incident.get(inc_id) or by_ia_id.get(inc.get("incident_analysis_neris_id"))
        if ia:
            matched[inc_id] = ia
    return matched


def flatten_record(obj, prefix=""):
    """Flatten a nested record into one level of columns:
       dicts         -> parent_child keys
       lists of values -> joined with '||'
       lists of dicts  -> each sub-field joined with '||' across the items
       GeoJSON points  -> _longitude / _latitude
    Internal neris_uid fields and per-section last_modified stamps are skipped
    (the record's own top-level last_modified is kept)."""
    out = {}
    if not isinstance(obj, dict):
        return out
    if obj.get("type") == "Point" and isinstance(obj.get("coordinates"), list) \
            and len(obj["coordinates"]) >= 2:
        out[f"{prefix}longitude"] = obj["coordinates"][0]
        out[f"{prefix}latitude"] = obj["coordinates"][1]
        return out
    for k, v in obj.items():
        if k == "neris_uid" or (prefix and k == "last_modified"):
            continue
        key = f"{prefix}{k}"
        if isinstance(v, dict):
            out.update(flatten_record(v, key + "_"))
        elif isinstance(v, list):
            if all(not isinstance(x, (dict, list)) for x in v):
                out[key] = "||".join(str(x) for x in v if x not in (None, ""))
            else:
                merged = {}
                for item in v:
                    flat = flatten_record(item) if isinstance(item, dict) else {"": item}
                    for fk, fv in flat.items():
                        merged.setdefault(fk, []).append("" if fv is None else str(fv))
                for fk, vals in merged.items():
                    out[f"{key}_{fk}" if fk else key] = "||".join(vals)
        else:
            out[key] = v
    return out

_LOCATION_FIELDS = {
    "street_prefix": "street_prefix_direction",
    "street_name":   "street",
    "street_type":   "street_postfix",
    "street_suffix": "street_postfix_direction",
    "apartment":     "unit_value",
    "city":          "incorporated_municipality",
    "state":         "state",
    "zip_code":      "postal_code",
    "county":        "county",
}


def _house_number(loc):
    """NERIS often stores the house number ONLY in complete_number."""
    num = loc.get("complete_number")
    if num not in (None, ""):
        return str(num)
    num = f"{loc.get('number_prefix') or ''}{loc.get('number') or ''}"
    if loc.get("number_suffix"):
        num = f"{num} {loc['number_suffix']}".strip()
    return num


def _coords(point_obj):
    if not point_obj or not isinstance(point_obj, dict):
        return None, None
    geom = point_obj.get("geometry") if isinstance(point_obj.get("geometry"), dict) else point_obj
    coords = (geom or {}).get("coordinates", [])
    if coords and isinstance(coords, list) and len(coords) >= 2:
        return coords[1], coords[0]
    return None, None


def consolidate_location(base, dispatch):
    """Each address part from the first location that has it:
    base geocoded -> base -> dispatch geocoded -> dispatch."""
    base_loc = base.get("location", {}) or {}
    base_geo = base_loc.get("geocoded_location", {}) or {}
    disp_loc = dispatch.get("location", {}) or {}
    disp_geo = disp_loc.get("geocoded_location", {}) or {}

    def has_data(d):
        return any(v for k, v in d.items() if k != "geocoded_location")

    sources = [(n, d, p) for n, d, p in (
        ("base_location_geocoded",     base_geo, base_geo.get("point")),
        ("base_location",              base_loc, None),
        ("dispatch_location_geocoded", disp_geo, disp_geo.get("point")),
        ("dispatch_location",          disp_loc, None),
    ) if d and has_data(d)]
    if not sources:
        return "", {}

    final = {"street_number": next((n for n in (_house_number(d) for _, d, _ in sources) if n), "")}
    for field, key in _LOCATION_FIELDS.items():
        final[field] = next((d.get(key) for _, d, _ in sources if d.get(key) not in (None, "")), "")
    lat = lon = None
    for _, _, pt in sources:
        lat, lon = _coords(pt)
        if lat is not None:
            break
    final.update({"latitude": lat if lat is not None else "",
                  "longitude": lon if lon is not None else "",
                  "census_tract": "", "census_block": "", "parcel_id": ""})
    return sources[0][0], final


def export_to_excel(incidents, analyses, client, label):
    import pandas as pd
    from openpyxl import Workbook
    from openpyxl.styles import Font, PatternFill, Alignment
    from openpyxl.utils import get_column_letter
    from openpyxl.cell import WriteOnlyCell
    try:
        from openpyxl.cell.cell import KNOWN_TYPES as _XL_TYPES
    except ImportError:
        _XL_TYPES = (str, int, float, bool, datetime, type(None))
    import pathlib

    if not incidents:
        print("⚠ No incidents to export.")
        return None

    date_str   = datetime.now().strftime("%Y-%m-%d")
    safe_label = "".join(c if c.isalnum() or c in " -_" else "" for c in label).strip()
    filename   = f"NERIS Incidents {safe_label} {date_str}.xlsx"

    # Department names (one lookup per department that appears in the data)
    dept_ids = {(inc.get("base") or {}).get("department_neris_id") for inc in incidents} - {None, ""}
    print(f"\nLooking up {len(dept_ids)} department names...")
    dept_names, name_failures = {}, []
    for i, did in enumerate(sorted(dept_ids), 1):
        try:
            entity = _unwrap(client.get_entity(did), f"get_entity({did})")
            dept_names[did] = entity.get("name", "") if isinstance(entity, dict) else ""
        except Exception as e:
            dept_names[did] = ""
            name_failures.append((did, str(e)))
        if i % 25 == 0:
            print(f"  {i}/{len(dept_ids)} departments looked up...")
    print("✓ Department lookup complete")
    if name_failures:
        print(f"⚠ {len(name_failures)} department name(s) could not be looked up (left blank):")
        for did, err in name_failures[:5]:
            print(f"    {did}: {err}")

    matched = match_analyses(incidents, analyses)

    def extract_list_field(lst, key):
        if not lst or not isinstance(lst, list):
            return ""
        return "||".join(str(item.get(key, "")) for item in lst
                         if isinstance(item, dict) and item.get(key))

    def join_list(lst):
        if not lst or not isinstance(lst, list):
            return ""
        return "||".join(str(x) for x in lst if x)

    # ---- Overview ----
    overview_rows = []
    for inc in incidents:
        base       = inc.get("base", {}) or {}
        dispatch   = inc.get("dispatch", {}) or {}
        status_obj = inc.get("incident_status", {}) or {}
        dept_id    = base.get("department_neris_id", "")
        type_list  = [it.get("type", "") for it in (inc.get("incident_types", []) or [])
                      if isinstance(it, dict) and it.get("type")]
        ia = matched.get(inc.get("neris_id"))
        overview_rows.append({
            "Incident NERIS ID":          inc.get("neris_id", ""),
            "Department/Entity ID":       dept_id,
            "Department Name":            dept_names.get(dept_id, ""),
            "Incident Number":            base.get("incident_number", ""),
            "Call Date":                  dispatch.get("call_create", ""),
            "Last Modified":              inc.get("last_modified", ""),
            "Incident Status":            status_obj.get("status", ""),
            "First Incident Type":        type_list[0] if len(type_list) > 0 else "",
            "Second Incident Type":       type_list[1] if len(type_list) > 1 else "",
            "Third Incident Type":        type_list[2] if len(type_list) > 2 else "",
            "People Present":             base.get("people_present", ""),
            "Animals Rescued":            base.get("animals_rescued", ""),
            "Outcome Narrative":          base.get("outcome_narrative", ""),
            "Displacement Count":         base.get("displacement_count", ""),
            "Submitter Type":             inc.get("submitter_account_type", ""),
            "Incident Analysis NERIS ID": (ia or {}).get("neris_id", ""),
            "Incident Analysis Status":   ((ia or {}).get("incident_analysis_status") or {}).get("status", ""),
        })

    # ---- Raw Data + Casualty & Rescue ----
    casualty_detail_rows = []
    processed = []
    for inc in copy.deepcopy(incidents):
        base     = inc.get("base", {}) or {}
        dispatch = inc.get("dispatch", {}) or {}
        dept_id  = base.get("department_neris_id", "")

        inc["department_name"]      = dept_names.get(dept_id, "")
        inc["department_neris_id"]  = dept_id
        inc["incident_number"]      = base.get("incident_number", "")
        inc["department_time_zone"] = (inc.get("department", {}) or {}).get("time_zone", "")

        inc_types = inc.get("incident_types", []) or []
        inc["primary_incident_types"] = "||".join(
            it.get("type", "") or "" for it in inc_types if isinstance(it, dict) and it.get("primary"))
        inc["other_incident_types"] = "||".join(
            it.get("type", "") or "" for it in inc_types if isinstance(it, dict) and not it.get("primary"))
        inc.pop("incident_types", None)

        inc["special_modifiers"] = extract_list_field(inc.get("special_modifiers", []), "type")

        aids = inc.get("aids", []) or []
        inc["aid_types"]          = extract_list_field(aids, "aid_type")
        inc["aid_directions"]     = extract_list_field(aids, "aid_direction")
        inc["aid_department_ids"] = extract_list_field(aids, "department_neris_id")
        inc.pop("aids", None)

        inc["nonfd_aid_types"] = extract_list_field(inc.get("nonfd_aids", []), "type")
        inc.pop("nonfd_aids", None)

        units = inc.get("unit_responses", []) or []
        inc["unit_ids"]            = extract_list_field(units, "reported_unit_id")
        inc["unit_neris_ids"]      = extract_list_field(units, "unit_neris_id")
        inc["total_units"]         = len(units)
        inc["total_staffing"]      = sum(u.get("staffing", 0) or 0 for u in units if isinstance(u, dict))
        inc["unit_response_modes"] = extract_list_field(units, "response_mode")
        inc.pop("unit_responses", None)

        disp_units = dispatch.get("unit_responses", []) or []
        dispatch["disp_unit_ids"]       = extract_list_field(disp_units, "reported_unit_id")
        dispatch["disp_total_units"]    = len(disp_units)
        dispatch["disp_total_staffing"] = sum(
            u.get("staffing", 0) or 0 for u in disp_units if isinstance(u, dict))
        dispatch.pop("unit_responses", None)

        dispatch["comments_text"] = extract_list_field(dispatch.get("comments", []), "comment")
        dispatch.pop("comments", None)

        base["displacement_causes"] = join_list(base.get("displacement_causes", []))

        location_source, final_location = consolidate_location(base, dispatch)
        inc["location_source"] = location_source
        for field, value in final_location.items():
            inc[f"location_{field}"] = value
        county_for_casualties = final_location.get("county", "")
        base.pop("location", None)
        dispatch.pop("location", None)

        parcel = inc.get("parcel", {}) or {}
        pa = (parcel.get("summary", {}) or {}).get("assessment", {}) or {}
        inc["parcel_primary_year_built"]      = pa.get("primary_year_built", "")
        inc["parcel_primary_zoning"]          = pa.get("primary_zoning", "")
        inc["parcel_primary_use"]             = pa.get("primary_use", "")
        inc["parcel_primary_owner_occupied"]  = pa.get("primary_owner_occupied", "")
        inc["parcel_primary_assessment_land"] = pa.get("primary_assessment_land", "")
        inc["parcel_computed_loss"]           = pa.get("computed_loss", "")
        inc.pop("parcel", None)

        exposures = inc.get("exposures", []) or []
        inc["exposure_count"]        = len(exposures)
        inc["exposure_damage_types"] = extract_list_field(exposures, "damage_type")
        inc.pop("exposures", None)

        casualties = inc.get("casualty_rescues", []) or []
        inc["casualty_count"]   = len(casualties)
        inc["casualty_types"]   = extract_list_field(casualties, "type")
        inc["casualty_ranks"]   = extract_list_field(casualties, "rank")
        inc["casualty_genders"] = extract_list_field(casualties, "gender")

        neris_id = inc.get("neris_id", "")
        for cas in casualties:
            if not isinstance(cas, dict):
                continue
            casualty_obj   = cas.get("casualty", {}) or {}
            injury         = casualty_obj.get("injury_or_noninjury", {}) or {}
            ff_details     = injury.get("ff_injury_details", {}) or {}
            rescue_obj     = cas.get("rescue", {}) or {}
            ffrescue       = rescue_obj.get("ffrescue_or_nonffrescue", {}) or {}
            removal        = ffrescue.get("removal_or_nonremoval", {}) or {}
            fire_removal   = removal.get("fire_removal", {}) or {}
            presence_known = rescue_obj.get("presence_known", {}) or {}
            mayday_obj     = rescue_obj.get("mayday", {}) or {}
            casualty_detail_rows.append({
                "Incident NERIS ID":    neris_id,
                "Department/Entity ID": dept_id,
                "Department Name":      dept_names.get(dept_id, ""),
                "Call Date":            dispatch.get("call_create", ""),
                "County":               county_for_casualties,
                "Type":                 cas.get("type", ""),
                "Rank":                 cas.get("rank", ""),
                "Years of Service":     cas.get("years_of_service", ""),
                "Birth Month Year":     cas.get("birth_month_year", ""),
                "Gender":               cas.get("gender", ""),
                "Race":                 cas.get("race", ""),
                "Injury Type":          injury.get("type", ""),
                "Injury Cause":         injury.get("cause", ""),
                "FF Unit NERIS ID":     ff_details.get("unit_neris_id", ""),
                "FF Reported Unit ID":  ff_details.get("reported_unit_id", ""),
                "FF Unit Continuity":   ff_details.get("unit_continuity", ""),
                "FF Incident Command":  ff_details.get("incident_command", ""),
                "FF Job Classification": ff_details.get("job_classification", ""),
                "FF Duty Type":         ff_details.get("duty_type", ""),
                "FF Action Type":       ff_details.get("action_type", ""),
                "FF Incident Stage":    ff_details.get("incident_stage", ""),
                "FF PPE Items":         join_list(ff_details.get("ppe_items", [])),
                "Rescue Type":          ffrescue.get("type", ""),
                "Rescue Actions":       join_list(ffrescue.get("actions", [])),
                "Rescue Impediments":   join_list(ffrescue.get("impediments", [])),
                "Removal Type":         removal.get("type", ""),
                "Removal Room Type":    removal.get("room_type", ""),
                "Removal Elevation Type": removal.get("elevation_type", ""),
                "Rescue Path Type":     removal.get("rescue_path_type", ""),
                "Gas Isolation":        removal.get("gas_isolation", ""),
                "Fire Removal Relative Suppression Time": fire_removal.get("relative_suppression_time", ""),
                "Presence Known Type":  presence_known.get("presence_known_type", ""),
                "Mayday":               mayday_obj.get("mayday", ""),
                "RIT Activated":        mayday_obj.get("rit_activated", ""),
                "Mayday Relative Suppression Time": mayday_obj.get("relative_suppression_time", ""),
            })
        inc.pop("casualty_rescues", None)

        med = inc.get("medical_details", []) or []
        inc["med_report_ids"]             = extract_list_field(med, "patient_care_report_id")
        inc["med_evaluations"]            = extract_list_field(med, "patient_care_evaluation")
        inc["med_patient_statuses"]       = extract_list_field(med, "patient_status")
        inc["med_transport_dispositions"] = extract_list_field(med, "transport_disposition")
        inc.pop("medical_details", None)

        elec = inc.get("electric_hazards", []) or []
        inc["electric_hazard_types"]         = extract_list_field(elec, "type")
        inc["electric_hazard_source_target"] = extract_list_field(elec, "source_or_target")
        inc.pop("electric_hazards", None)

        inc["powergen_hazard_count"] = len(inc.get("powergen_hazards") or [])
        inc.pop("powergen_hazards", None)

        fire = inc.get("fire_detail", {}) or {}
        fire["investigation_types"]    = join_list(fire.get("investigation_types", []))
        fire["suppression_appliances"] = join_list(fire.get("suppression_appliances", []))

        hazsit = inc.get("hazsit_detail", {}) or {}
        chems  = hazsit.get("chemicals", []) or []
        hazsit["chemical_names"]       = extract_list_field(chems, "name")
        hazsit["chemical_dot_classes"] = extract_list_field(chems, "dot_class")
        hazsit.pop("chemicals", None)

        for alarm_key in ("smoke_alarm", "fire_alarm", "other_alarm"):
            presence = (inc.get(alarm_key, {}) or {}).get("presence", {}) or {}
            presence["alarm_types"] = join_list(presence.get("alarm_types", []))

        fs_presence = (inc.get("fire_suppression", {}) or {}).get("presence", {}) or {}
        supp_types  = fs_presence.get("suppression_types", []) or []
        fs_presence["suppression_types"] = (
            extract_list_field(supp_types, "type")
            if supp_types and isinstance(supp_types[0], dict) else join_list(supp_types))

        cfs_presence = (inc.get("cooking_fire_suppression", {}) or {}).get("presence", {}) or {}
        cfs_presence["suppression_types"] = join_list(cfs_presence.get("suppression_types", []))

        an = (inc.get("actions_tactics", {}) or {}).get("action_noaction", {}) or {}
        an["actions"] = join_list(an.get("actions", []))

        processed.append(inc)

    df_raw = pd.json_normalize(processed, sep="_")

    exclude_cols = {
        "actions_tactics_last_modified", "actions_tactics_neris_uid",
        "base_location_geocoded_location_neris_uid", "base_location_neris_uid",
        "base_location_use_in_use_last_modified", "base_location_use_in_use_neris_uid",
        "base_location_use_neris_uid",
        "census_tract_incident_neris_id", "census_tract_last_modified", "census_tract_neris_uid",
        "cooking_fire_suppression_last_modified", "cooking_fire_suppression_neris_uid",
        "cooking_fire_suppression_presence_last_modified", "cooking_fire_suppression_presence_neris_uid",
        "csst_hazard_last_modified", "csst_hazard_neris_uid",
        "dispatch_last_modified", "dispatch_location_geocoded_location_neris_uid", "dispatch_neris_uid",
        "dispatch_tactic_timestamps_last_modified", "dispatch_tactic_timestamps_neris_uid",
        "fire_alarm_last_modified", "fire_alarm_neris_uid",
        "fire_alarm_presence_last_modified", "fire_alarm_presence_neris_uid",
        "fire_detail_last_modified", "fire_detail_neris_uid",
        "fire_suppression_last_modified", "fire_suppression_neris_uid",
        "fire_suppression_presence_last_modified", "fire_suppression_presence_neris_uid",
        "fire_suppression_presence_operation_type_effectiveness_last_modified",
        "fire_suppression_presence_operation_type_effectiveness_neris_uid",
        "fire_suppression_presence_operation_type_last_modified",
        "fire_suppression_presence_operation_type_neris_uid",
        "hazsit_detail_last_modified", "hazsit_detail_neris_uid",
        "incident_status_last_modified",
        "other_alarm_last_modified", "other_alarm_neris_uid",
        "other_alarm_presence_last_modified", "other_alarm_presence_neris_uid",
        "smoke_alarm_last_modified", "smoke_alarm_neris_uid",
        "smoke_alarm_presence_operation_alerted_failed_other_last_modified",
        "smoke_alarm_presence_operation_alerted_failed_other_neris_uid",
        "smoke_alarm_presence_operation_last_modified", "smoke_alarm_presence_operation_neris_uid",
        "tactic_timestamps_last_modified", "tactic_timestamps_neris_uid",
        "weather_last_modified", "weather_neris_uid",
        "department_time_zone", "base_neris_uid", "base_last_modified",
        "base_department_neris_id", "incident_status_created_by",
        "dispatch_location_neris_uid",
        "tactic_timestamps_command_established", "tactic_timestamps_completed_sizeup",
        "tactic_timestamps_suppression_complete", "tactic_timestamps_primary_search_begin",
        "tactic_timestamps_primary_search_complete", "tactic_timestamps_water_on_fire",
        "tactic_timestamps_fire_under_control", "tactic_timestamps_fire_knocked_down",
        "weather_incident_neris_id",
        "dispatch_tactic_timestamps_command_established",
        "dispatch_tactic_timestamps_completed_sizeup",
        "dispatch_tactic_timestamps_suppression_complete",
        "dispatch_tactic_timestamps_fire_under_control",
    }
    df_raw = df_raw.drop(columns=[c for c in exclude_cols if c in df_raw.columns])

    def reorder_columns(df):
        first_cols = ["department_neris_id", "department_name", "neris_id",
                      "neris_uid", "incident_status_status"]
        location_cols = [
            "location_source", "location_street_number", "location_street_prefix",
            "location_street_name", "location_street_type", "location_street_suffix",
            "location_apartment", "location_city", "location_state",
            "location_zip_code", "location_county", "location_latitude",
            "location_longitude", "location_census_tract", "location_census_block",
            "location_parcel_id",
        ]
        hazard_cols = ["electric_hazard_types", "electric_hazard_source_target",
                       "powergen_hazard_count"]
        ef = [c for c in first_cols    if c in df.columns]
        el = [c for c in location_cols if c in df.columns]
        eh = [c for c in hazard_cols   if c in df.columns]
        pinned = set(ef + el + eh + ["last_modified"])
        rest = [c for c in df.columns if c not in pinned]
        order = ef + el + rest + eh
        if "last_modified" in df.columns:
            order.append("last_modified")
        return df[order]

    df_raw = reorder_columns(df_raw)

    # ---- Incident Analysis: ALL fields, one row per analysis ----
    inc_by_id = {inc.get("neris_id"): inc for inc in incidents}
    ia_rows = []
    for inc_id, ia in matched.items():
        inc = inc_by_id.get(inc_id) or {}
        dept_id = (inc.get("base") or {}).get("department_neris_id", "")
        flat = flatten_record(ia)
        flat["incident_analysis_neris_id"] = flat.pop("neris_id", "")
        row = {
            "Incident NERIS ID":    inc_id,
            "Department/Entity ID": dept_id,
            "Department Name":      dept_names.get(dept_id, ""),
            "Incident Number":      (inc.get("base") or {}).get("incident_number", ""),
            "Call Date":            (inc.get("dispatch") or {}).get("call_create", ""),
        }
        row.update(flat)
        ia_rows.append(row)
    df_ia = pd.DataFrame(ia_rows)
    if not df_ia.empty:
        lead = ["Incident NERIS ID", "Department/Entity ID", "Department Name",
                "Incident Number", "Call Date", "incident_analysis_neris_id"]
        df_ia = df_ia[[c for c in lead if c in df_ia.columns] +
                      [c for c in df_ia.columns if c not in lead]]
    used_ids = {ia.get("neris_id") for ia in matched.values()}
    exported_ids = set(inc_by_id)
    fallback_ids = {inc.get("incident_analysis_neris_id") for inc in incidents} - {None, ""}
    superseded_ia = unmatched_ia = 0
    for ia in {a.get("neris_id"): a for a in analyses if isinstance(a, dict)}.values():
        if ia.get("neris_id") in used_ids:
            continue
        target = (ia.get("base") or {}).get("neris_id_incident")
        if target in exported_ids or ia.get("neris_id") in fallback_ids:
            superseded_ia += 1          # an older analysis replaced by a newer one
        else:
            unmatched_ia += 1           # its incident isn't in this export

    def clean_df(df):
        drop = [col for col in df.columns
                if df[col].dropna().pipe(
                    lambda s: s.empty or s.apply(lambda x: x == "" or x == [] or str(x) == "[]").all())]
        return df.drop(columns=drop)

    df_overview   = clean_df(pd.DataFrame(overview_rows).fillna(""))
    df_raw        = clean_df(df_raw)
    df_casualties = (clean_df(pd.DataFrame(casualty_detail_rows).fillna(""))
                     if casualty_detail_rows else pd.DataFrame())
    df_ia         = clean_df(df_ia.fillna("")) if not df_ia.empty else df_ia

    print(f"  Overview:          {len(df_overview.columns)} columns")
    print(f"  Raw Data:          {len(df_raw.columns)} columns")
    print(f"  Casualty & Rescue: {len(df_casualties)} rows")
    print(f"  Incident Analysis: {len(df_ia)} rows, {len(df_ia.columns)} columns")
    if superseded_ia > 0:
        print(f"  ({superseded_ia} older incident analysis record(s) were replaced by a newer "
              f"analysis of the same incident; only the newest is kept)")
    if unmatched_ia > 0:
        print(f"  ({unmatched_ia} incident analysis record(s) belong to incidents outside "
              f"this date range and are not included)")

    # ---- Write (streaming, so large exports don't exhaust memory) ----
    illegal = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f]")
    EXCEL_CELL_MAX = 32767

    def sanitize(val):
        if isinstance(val, (list, tuple, set)):
            if not val:
                return None
            val = ("||".join(str(x) for x in val)
                   if all(not isinstance(x, (dict, list, tuple, set)) for x in val)
                   else json.dumps(list(val), default=str))
        elif isinstance(val, dict):
            val = json.dumps(val, default=str) if val else None
        elif isinstance(val, datetime) and val.tzinfo is not None:
            val = val.astimezone(timezone.utc).replace(tzinfo=None)
        try:
            if pd.isna(val):
                return None
        except (TypeError, ValueError):
            pass
        if isinstance(val, str):
            val = illegal.sub("", val)
            if len(val) > EXCEL_CELL_MAX:
                suffix = " ...[truncated]"
                val = val[:EXCEL_CELL_MAX - len(suffix)] + suffix
        elif val is not None and not isinstance(val, _XL_TYPES):
            val = str(val)
        return val

    fill  = PatternFill(start_color="1F4E78", end_color="1F4E78", fill_type="solid")
    font  = Font(color="FFFFFF", bold=True, size=11)
    align = Alignment(horizontal="center", vertical="center", wrap_text=True)

    def write_sheet(wb, df, name):
        ws = wb.create_sheet(name)
        headers = list(df.columns)
        widths = [len(str(h)) for h in headers]
        for row in df.head(50).itertuples(index=False, name=None):
            for i, v in enumerate(row):
                v = sanitize(v)
                if v:
                    widths[i] = max(widths[i], len(str(v)))
        for col_idx, w in enumerate(widths, 1):
            ws.column_dimensions[get_column_letter(col_idx)].width = min(max(w + 2, 12), 60)
        ws.freeze_panes = "A2"
        header_cells = []
        for h in headers:
            c = WriteOnlyCell(ws, value=h)
            c.fill, c.font, c.alignment = fill, font, align
            header_cells.append(c)
        ws.append(header_cells)
        for i, row in enumerate(df.itertuples(index=False, name=None), 1):
            ws.append([sanitize(v) for v in row])
            if i % 20000 == 0:
                print(f"    {name}: {i:,}/{len(df):,} rows written...")

    wb = Workbook(write_only=True)
    write_sheet(wb, df_overview, "Overview")
    write_sheet(wb, df_raw, "Raw Data")
    if not df_casualties.empty:
        write_sheet(wb, df_casualties, "Casualty & Rescue")
    if not df_ia.empty:
        write_sheet(wb, df_ia, "Incident Analysis")

    docs_dir = pathlib.Path.home() / "Documents"
    docs_dir.mkdir(parents=True, exist_ok=True)
    filepath = str(docs_dir / filename)
    wb.save(filepath)

    sheets = "Overview, Raw Data"
    if not df_casualties.empty:
        sheets += ", Casualty & Rescue"
    if not df_ia.empty:
        sheets += ", Incident Analysis"
    print(f"\n✓ Exported: {filepath}")
    print(f"  Incidents          : {len(incidents)}")
    print(f"  Incident analyses  : {len(matched)}")
    print(f"  Sheets             : {sheets}")
    return filepath

def main():
    ensure_dependencies()

    (entity_set_nuid, username, password,
     range_type, start_date, end_date) = prompt_config()

    client = authenticate(username, password)

    neris_ids, entity_set_name = get_entity_set_neris_ids(client, entity_set_nuid)
    if not neris_ids:
        sys.exit("✗ No member entity IDs found in entity set — nothing to fetch.")

    # Only fire department entities (FD prefix) support the neris_id_entity filter.
    dept_ids = [nid for nid in neris_ids if nid.startswith("FD")]
    skipped  = [nid for nid in neris_ids if not nid.startswith("FD")]
    if skipped:
        print(f"\n⚠ Skipping {len(skipped)} non-department entity ID(s): {', '.join(skipped)}")
    if not dept_ids:
        sys.exit("✗ No fire department (FD) entities found in this entity set.")

    call_create_start, call_create_end = calculate_date_range(range_type, start_date, end_date)

    incidents, inc_errors = fetch_all(
        client, dept_ids, "incidents", fetch_incidents_for_entity,
        call_create_start=call_create_start, call_create_end=call_create_end)
    if not incidents:
        print("⚠ No incidents found for the given parameters.")
        return

    # Analyses only for departments that actually have incidents in range.
    depts_with_incidents = sorted({(inc.get("base") or {}).get("department_neris_id")
                                   for inc in incidents} - {None, ""})
    analyses, ia_errors = fetch_all(
        client, depts_with_incidents, "incident analyses", fetch_analyses_for_entity)

    print("\nExporting to Excel...")
    export_to_excel(incidents, analyses, client, label=entity_set_name or "Entity Set")

    if inc_errors or ia_errors:
        print("\n" + "!" * 60)
        if inc_errors:
            print(f"  ⚠ Incidents could not be pulled for {len(inc_errors)} department(s);")
            print("    their incidents are MISSING from the export.")
        if ia_errors:
            print(f"  ⚠ Incident analyses could not be pulled for {len(ia_errors)} department(s);")
            print("    their incidents are in the export, but with no analysis attached.")
        print("  See the ⚠ lines above for which departments and why.")
        print("!" * 60)

    print("\n" + "=" * 60)
    print("  PROCESS COMPLETE")
    print("=" * 60)


if __name__ == "__main__":
    main()
